# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# uv.lock IS tracked; do not ignore it.

# --- Run products (never committed) ---
runs/
results/
*.log

# --- ALE task-folder contract: the engine's asset roots, the setup folder's, and the engine cache ---
# (upstream ASSET_ROOTS in vendor/ale/packages/ale-run/src/ale/run/assets.py; files there never go into git.
# This repository's large files come from its Hugging Face dataset at image build: docs/task-assets.md)
tasks/**/environment/assets/
tasks/**/environment/setup/assets/
tasks/**/tests/assets/
tasks/**/solution/assets/
templates/**/environment/assets/
templates/**/environment/setup/assets/
templates/**/tests/assets/
templates/**/solution/assets/
.ale-cache/

# --- Large data / model artifacts (provisioned, not committed) ---
*.hdf5
*.h5
*.zarr
*.bag
*.pt
*.ckpt
*.pkl
*.npz
*.mp4
*.pcd
*.tar.gz

# --- OS / editor cruft ---
.DS_Store
*.swp
