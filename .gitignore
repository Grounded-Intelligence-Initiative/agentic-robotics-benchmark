# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
# uv.lock IS tracked; do not ignore it.

# --- Run products (never committed) ---
runs/
results/
*.log

# --- ALE task-folder contract: the engine's three asset roots, at task depth, and the engine cache ---
# (upstream ASSET_ROOTS in vendor/ale/packages/ale-run/src/ale/run/assets.py: the engine leaves them out of a task's
# content digest and `ale assets` syncs them, so files there never go into git. Anything else in a task folder, a
# nested assets/ of a vendored library included, is hashed and uploaded and must be tracked. This repository's large
# files come from its Hugging Face dataset at image build: docs/task-assets.md)
tasks/*/*/environment/assets/
tasks/*/*/tests/assets/
tasks/*/*/solution/assets/
templates/*/environment/assets/
templates/*/tests/assets/
templates/*/solution/assets/
.ale-cache/

# --- Large data / model artifacts (provisioned, not committed) ---
*.hdf5
*.h5
*.zarr
*.bag
*.pt
*.ckpt
*.pkl
*.npz
*.mp4
*.pcd
*.tar.gz

# --- OS / editor cruft ---
.DS_Store
*.swp
