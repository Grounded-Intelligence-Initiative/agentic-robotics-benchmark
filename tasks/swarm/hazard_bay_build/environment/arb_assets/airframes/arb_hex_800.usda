#usda 1.0
(
    defaultPrim = "arb_hex_800"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "arb_hex_800" (
    variants = {
        string look = "proxy"
    }
    prepend variantSets = "look"
)
{
    def "Looks"
    {
        def Material "hull"
        {
            token outputs:surface.connect = </arb_hex_800/Looks/hull/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.24, 0.14, 0.12)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }

        def Material "arm"
        {
            token outputs:surface.connect = </arb_hex_800/Looks/arm/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.11)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "motor"
        {
            token outputs:surface.connect = </arb_hex_800/Looks/motor/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.72)
                float inputs:metallic = 0.8
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "prop"
        {
            token outputs:surface.connect = </arb_hex_800/Looks/prop/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "gear"
        {
            token outputs:surface.connect = </arb_hex_800/Looks/gear/S.outputs:surface>

            def Shader "S"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.45, 0.1)
                float inputs:metallic = 0
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        custom string arb:airframe_model = "arb_hex_800"
        custom int arb:rotors = 6
        float physics:mass = 4.1

        def Cube "hull" (
