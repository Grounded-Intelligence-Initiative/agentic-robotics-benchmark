{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The replica model that quadmodel.py turns into the dynamics model of acceptance procedure B-14: the Appendix-D geometry (m), the stops (rad, Appendix-D conventions), the housing class of each joint type with its can box (seat frame, z = can axis), the 12 module seats, the pack bay, the pod mount with its CoM marks, and every printed part and fixed component as a rigid inertial (mass kg, CoM m and inertia kg.m2 about the CoM, in the frame of the body it is attached to).",
  "properties": {
    "class_box_m": {
      "additionalProperties": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "R52",
          "R38",
          "R62"
        ]
      },
      "type": "object"
    },
    "format": {
      "const": "quad-model/1"
    },
    "geometry": {
      "additionalProperties": false,
      "properties": {
        "foot_radius": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "hip_spacer": {
          "minimum": 0,
          "type": "number"
        },
        "knee_branch": {
          "description": "knee_branch gives the knee configuration of B-05 in two characters, the first for the front legs (fl, fr) and the second for the rear legs (rl, rr): '>' puts the knee axis behind the line from the leg's hip_pitch axis to its foot point (toward -x of the trunk frame of Appendix D), '<' puts it ahead of that line (toward +x), so the two characters picture the legs as seen from the left (+y) side with the nose on the left.",
          "enum": [
            "><",
            "<>",
            ">>",
            "<<"
          ],
          "type": "string"
        },
        "leg_offset": {
          "minimum": 0,
          "type": "number"
        },
        "pitch_axis_drop": {
          "type": "number"
        },
        "pitch_axis_spacing": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "roll_axis_spacing": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "shank_length": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "spacer_legs": {
          "items": {
            "enum": [
              "fl",
              "fr",
              "rl",
              "rr"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "thigh_length": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "pitch_axis_spacing",
        "roll_axis_spacing",
        "pitch_axis_drop",
        "leg_offset",
        "hip_spacer",
        "spacer_legs",
        "thigh_length",
        "shank_length",
        "foot_radius",
        "knee_branch"
      ],
      "type": "object"
    },
