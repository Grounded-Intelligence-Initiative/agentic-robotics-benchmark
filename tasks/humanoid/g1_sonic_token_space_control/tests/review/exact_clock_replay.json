  "solver_python": "import json\nfrom pathlib import Path\nimport sys\n\ntapes = [[json.loads(row) for row in Path(f'{i}.jsonl').read_text().splitlines()] for i in range(4)]\nordinal = -1\nprint('READY', flush=True)\nfor line in sys.stdin:\n    message = json.loads(line)\n    kind = message['type']\n    if kind == 'reset':\n        ordinal += 1\n        if ordinal >= len(tapes):\n            raise ValueError('unexpected reset')\n        reply = {'ok': True}\n    elif kind == 'act':\n        tick = message['t']\n        tape = tapes[ordinal]\n        if ordinal < 0 or not 0 <= tick < len(tape):\n            raise ValueError('clock outside tape')\n        reply = {'action': {'rows': tape[tick:tick + 5 - tick % 5]}}\n    elif kind == 'close':\n        reply = {'ok': True}\n    else:\n        raise ValueError('unknown operation')\n    print(json.dumps(reply, separators=(',',':'), allow_nan=False), flush=True)\n    if kind == 'close':\n        break\n",
