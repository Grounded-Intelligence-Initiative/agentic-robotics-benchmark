#usda 1.0
(
    defaultPrim = "Curtain"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Curtain"
{
    def "Looks"
    {
        def Material "cloth" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Curtain/Looks/cloth/Shader.outputs:surface>
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.6

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.23, 0.42)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
