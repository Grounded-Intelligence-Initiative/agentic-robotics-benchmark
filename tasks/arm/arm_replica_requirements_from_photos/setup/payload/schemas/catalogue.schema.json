{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Your reading of datasheets/DS-*.png (with the erratum applied) and price_list.md, in SI units: torques N.m, speeds rad/s, currents A, voltages V, inertia kg m2, masses kg, prices USD. Lists in the quote's order. Only the practice checker reads this file (to score the BOM criteria of a practice instance under YOUR reading); the grader uses the vendors' own numbers.",
  "properties": {
    "boards": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "input_range_v": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "part_id": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          },
          "protocols": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "part_id",
          "protocols",
          "input_range_v",
          "price_usd"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "format": {
      "type": "string"
    },
    "psus": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "output_v": {
            "type": "number"
          },
          "part_id": {
            "type": "string"
          },
          "price_usd": {
            "type": "number"
          },
          "rated_current_a": {
            "type": "number"
          }
        },
        "required": [
          "part_id",
          "output_v",
          "rated_current_a",
          "price_usd"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "servos": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "body_class": {
            "enum": [
              "standard",
              "compact",
              "large"
            ],
            "type": "string"
          },
          "mass_kg": {
            "type": "number"
          },
          "no_load_current_a": {
            "type": "number"
          },
          "output_inertia_kgm2": {
            "type": "number"
          },
          "part_id": {
            "type": "string"
          },
          "points": {
            "items": {
              "properties": {
                "no_load_speed_rad_s": {
                  "type": "number"
                },
                "stall_current_a": {
                  "type": "number"
                },
                "stall_torque_nm": {
                  "type": "number"
                },
                "voltage_v": {
                  "type": "number"
                }
              },
              "required": [
                "voltage_v",
                "stall_torque_nm",
                "no_load_speed_rad_s",
                "stall_current_a"
              ],
              "type": "object"
            },
            "maxItems": 2,
            "minItems": 1,
            "type": "array"
          },
          "price_usd": {
            "type": "number"
          },
          "protocol": {
            "type": "string"
          },
          "rated_torque_nm": {
            "type": "number"
          },
          "vendor": {
            "type": "string"
          },
          "voltage_range_v": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "part_id",
          "vendor",
          "body_class",
          "protocol",
          "voltage_range_v",
          "points",
          "no_load_current_a",
          "rated_torque_nm",
          "output_inertia_kgm2",
          "mass_kg",
          "price_usd"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "vendors": {
      "additionalProperties": {
        "properties": {
          "inspected": {
            "type": "boolean"
          }
        },
        "required": [
          "inspected"
        ],
        "type": "object"
      },
      "type": "object"
    }
  },
  "required": [
    "servos",
    "boards",
    "psus",
    "vendors"
  ],
  "title": "req-i2-catalogue/1 transcription of the vendor pages and the quote (SI units)",
  "type": "object"
}
