# The task's panel: the open windows (FreeCAD and its dialogs) and a clock (the session has a time limit). No launcher.
panel_items = TC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 2 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 0
panel_dock = 0
strut_policy = follow_size
autohide = 0
rounded = 0
border_width = 0
background_color = #2e3440 100
border_color = #2e3440 100
taskbar_mode = single_desktop
taskbar_padding = 2 2 4
taskbar_background_id = 0
taskbar_name = 0
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 260 24
task_padding = 4 2 4
task_font_color = #e5e9f0 100
task_active_font_color = #ffffff 100
time1_format = %H:%M:%S
time2_format = %Y-%m-%d
clock_font_color = #e5e9f0 100
clock_padding = 8 0
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none
